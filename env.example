# 复制到仓库外，例如 ~/.config/gpt-ads-feed/env，并 chmod 600
# 凭证只放这里；不要提交进仓库，不要写进 config.json
# 脚本只从环境变量读凭证，run_daily.sh 负责 source 这个文件

# ── Shopify（必填）───────────────────────────────────────────────────────
# 自定义 App 的 Admin API access token
# 权限：read_products 必给；再给 read_inventory 才能拿到库存数量/超卖策略/是否需配送
# 只给 read_products 也能跑，脚本会自动摘掉库存字段组并在日志里说明
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 全量快照 SFTP（不上传就留空，配合 --dry-run）─────────────────────────
# 在 https://ads.openai.com 的 Feeds 区创建 feed 连接后，这些值才会出现
OPENAI_FEED_SFTP_HOST=sftp.example.openai.com
OPENAI_FEED_SFTP_USER=your_sftp_user
OPENAI_FEED_SFTP_PORT=22
# 目标目录，留空表示登录后的默认目录
OPENAI_FEED_SFTP_DIR=

# 二选一：密钥（推荐）或密码。两个都填时优先用密钥
OPENAI_FEED_SFTP_KEY=~/.ssh/openai_feed_ed25519
# OPENAI_FEED_SFTP_PASSWORD=

# host key 校验：脚本明确拒绝未知 host key（不用 AutoAddPolicy）
# 留空则读 ~/.ssh/known_hosts。首次连接前先固化指纹：
#   ssh-keyscan -p 22 sftp.example.openai.com >> ~/.ssh/known_hosts
OPENAI_FEED_SFTP_KNOWN_HOSTS=

# ── 盘中增量 Delta API（只有 --delta 才需要）──────────────────────────────
# 注意：Delta 只能改「已存在变体」的库存与标题，改不了价格，也建不了新品
# 需要 OpenAI 单独开通权限，未开通时脚本会记为 skipped 而不是失败
OPENAI_ADS_API_KEY=
OPENAI_ADS_FEED_ID=product_feed_xxx

# ── 通知（可选，留空就只打日志）──────────────────────────────────────────
DISCORD_WEBHOOK_URL=
